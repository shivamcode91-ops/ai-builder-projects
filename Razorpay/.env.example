# AgentGuard environment. All server-side only — never prefix with NEXT_PUBLIC_.
# Every var here is optional. With none of them set the app still runs end to end:
# rule-based verdicts + simulated execution.

# --- intent verifier -------------------------------------------------------
# ALL OPTIONAL, AND THE PUBLIC DEPLOYMENT SETS NONE OF THEM.
#
# With no key here the app runs in demo mode: layer 1 is computed live, and
# layer 2 serves the recorded responses in lib/recorded.js — real answers from a
# real model, labelled as a recording on screen. A visitor can paste their own
# key in the app to run layer 2 live on their own account.
#
# Set a key here only for a private deployment. Providers are tried in order and
# the first that answers wins, so a rate limit or an empty balance on one falls
# through to the next instead of dropping to the rule engine.
#
# Default order: openrouter -> groq -> anthropic. Override with a comma list,
# e.g. INTENT_PROVIDER=groq,openrouter
INTENT_PROVIDER=

# OpenRouter — one key, ~370 models. Cheapest option that passes the eval.
OPENROUTER_API_KEY=
# Verified 6/6 on the intent probes. Alternatives, all 6/6:
#   deepseek/deepseek-chat            ~0.4s   $0.20/$0.80  (fastest)
#   google/gemini-2.5-flash-lite      ~1.0s   $0.10/$0.40  (cheapest — default)
#   moonshotai/kimi-k3                ~2.3s   $3.00/$15.00 (strongest, priciest)
#   moonshotai/kimi-k2.6              ~2.1s   $0.65/$2.72
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Groq — free tier, very fast, but rate-limits hard (429 after a few calls),
# so it suits being a fallback rather than the primary.
GROQ_API_KEY=
# Only Groq model on the free tier that accepts json_schema; llama-3.3-70b and
# qwen3.6-27b both reject it.
GROQ_MODEL=openai/gpt-oss-120b

# Anthropic direct.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Razorpay execution ----------------------------------------------------
# MUST be test keys — a key that does not start with rzp_test_ is refused and
# execution falls back to simulate.
RZP_KEY_ID=
RZP_KEY_SECRET=

# Razorpay MCP execution (merchant token for mcp.razorpay.com/mcp)
RZP_MERCHANT_TOKEN=

# Force an execution mode instead of auto-detecting: rest | mcp | simulate
RZP_EXEC_MODE=
